/-- `a * a ≠ N` when `s * s < N < (s + 1) * (s + 1)`. -/
lemma ne_sq_of_between {N s : ℕ} (h1 : s * s < N) (h2 : N < (s + 1) * (s + 1)) (a : ℕ) :
    a * a ≠ N := by
  intro h
  rcases Nat.lt_or_ge s a with ha | ha
  · have := Nat.mul_self_le_mul_self (show s + 1 ≤ a from ha); omega
  · have := Nat.mul_self_le_mul_self ha; omega

/-- A bounded-search certificate: if `q < 27 (B+1)^2` and for each `b ≤ B` the list entry `S[b]`
brackets `q - 27 b^2` strictly between consecutive squares, then `q ≠ a^2 + 27 b^2` in `ℕ`. -/
lemma not_rep_nat (q B : ℕ) (S : List ℕ) (hB : q < 27 * (B + 1) * (B + 1))
    (hcert : ∀ b < B + 1, S.getD b 0 * S.getD b 0 < q - 27 * b * b ∧
      q - 27 * b * b < (S.getD b 0 + 1) * (S.getD b 0 + 1)) :
    ∀ a b : ℕ, a * a + 27 * b * b ≠ q := by
  intro a b h
  have hb : b < B + 1 := by
    by_contra hb
    have : (B + 1) * (B + 1) ≤ b * b := Nat.mul_self_le_mul_self (by omega)
    nlinarith
  obtain ⟨h1, h2⟩ := hcert b hb
  exact ne_sq_of_between h1 h2 a (by omega)

/-- The integer form: no integers `a, b` with `a^2 + 27 b^2 = q`. -/
lemma not_rep_int (q : ℕ) (hq : ∀ a b : ℕ, a * a + 27 * b * b ≠ q) :
    ¬ ∃ a b : ℤ, a ^ 2 + 27 * b ^ 2 = q := by
  rintro ⟨a, b, h⟩
  apply hq a.natAbs b.natAbs
  zify
  have ha := abs_mul_abs_self a
  have hb := abs_mul_abs_self b
  linarith

